KP_DB_PATH=data/karachi_pulse.db

# --- v2 -------------------------------------------------------------------------------------------
# REQUIRED before collecting real OSINT: random string used to hash author handles (they are never stored raw).
# Generate one:  python -c "import secrets; print(secrets.token_hex(16))"
KP_PRIVACY_SALT=

# Optional: makes the evidence ledger HMAC-keyed. Without it the hash chain is tamper-EVIDENT but a person who
# can rewrite the whole SQLite file could rebuild it. Keep this secret and OUTSIDE git.
KP_LEDGER_KEY=

# Optional: ONNX Runtime CPU threads (0 = automatic, max 4).
KP_EDGE_THREADS=0

# Optional weather API key (app works without it)
WEATHER_API_KEY=

# --- v2.1 ------------------------------------------------------------------------------------------
# Local differential privacy on precise report coordinates (1 = on, 0 = off). Default on.
KP_LDP=1
# Also noise SYNTHETIC demo posts (default off so the offline demo stays reproducible).
KP_LDP_SYNTHETIC=0
# Folder holding model.onnx + tokenizer.json of a multilingual sentence encoder (see docs/multimodal_fusion.md section 7).
KP_TEXT_MODEL_DIR=models/text
# Extra hazard seed phrases (JSON: {"pothole": [["khadda", 0.6]]}), loaded on top of the built-ins.
KP_TEXT_SEEDS=data/hazard_seeds.json
# Privacy level l within radius r (epsilon = l / r per metre). Defaults: ln(4) within 100 m.
KP_LDP_LEVEL=1.3862943611198906
KP_LDP_RADIUS_M=100
# Satellite change method: lsma (default, needs the SWIR band) or ndwi (legacy index method).
KP_SAT_METHOD=lsma
