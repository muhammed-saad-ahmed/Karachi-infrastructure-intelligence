KP_DB_PATH=data/karachi_pulse.db

# --- v2 -------------------------------------------------------------------------------------------
# REQUIRED before collecting real OSINT: random string used to hash author handles (they are never stored raw).
# Generate one:  python -c "import secrets; print(secrets.token_hex(16))"
KP_PRIVACY_SALT=

# Optional: makes the evidence ledger HMAC-keyed. Without it the hash chain is tamper-EVIDENT but a person who
# can rewrite the whole SQLite file could rebuild it. Keep this secret and OUTSIDE git.
KP_LEDGER_KEY=

# Optional: ONNX Runtime CPU threads (0 = automatic, max 4).
KP_EDGE_THREADS=0

# Optional weather API key (app works without it)
WEATHER_API_KEY=
